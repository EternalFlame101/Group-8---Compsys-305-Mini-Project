library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;

entity Sprites_ROM is
    generic (
        DEPTH     : positive := 64;
        ADDR_BITS : positive := 6;     -- log2(DEPTH)
        MIF_FILE  : string   := "sprite.mif"
    );
    port (
        clock   : in  std_logic;
        address : in  std_logic_vector(ADDR_BITS - 1 downto 0);
        red     : out std_logic_vector(3 downto 0);
        green   : out std_logic_vector(3 downto 0);
        blue    : out std_logic_vector(3 downto 0)
    );
end entity Sprites_ROM;

architecture rom_behaviour of Sprites_ROM is

    type rom_type is array (0 to DEPTH - 1) of std_logic_vector(11 downto 0);

    signal ROM : rom_type;

    attribute ram_init_file         : string;
    attribute ram_init_file of ROM  : signal is MIF_FILE;

begin
    process (clock)
    begin
        if clock'event and clock = '1' then
            red   <= ROM(conv_integer(address))(11 downto 8);
            green <= ROM(conv_integer(address))(7  downto 4);
            blue  <= ROM(conv_integer(address))(3  downto 0);
        end if;
    end process;

end architecture rom_behaviour;