library IEEE;
use IEEE.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity Background_Manager is
	port (background_red,   background_green,   background_blue : in  std_logic_vector(3 downto 0);
			track_red,   		track_green,   	  track_blue 		: in  std_logic_vector(3 downto 0)
			red_out,          green_out,          blue_out        : out std_logic_vector(3 downto 0));
end entity Background_Manager;

architecture background_manager_behaviour of Background_Manager is
    -- Active signals — true if that layer has anything to draw
    signal background_active : std_logic;
    signal track_active 	  : std_logic;
begin
    -- A layer is active if any channel is non zero
    background_active <= '1' when (background_red or background_green or background_blue) /= "0000" else '0';
    track_active <= '1' when (track_red or track_green or track_blue) /= "0000" else '0';

    -- Priority mux — highest priority first, background always last
    red_out   <= track_red   when track_active = '1' else
                 background_red;

    green_out <= track_green when track_active = '1' else
                 background_green;

    blue_out  <= track_blue  when track_active = '1' else
                 background_blue;
end architecture graphics_manager_behaviour;