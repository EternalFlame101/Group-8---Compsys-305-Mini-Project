-- spawn_patterns.mif
-- 9-bit pattern: [8:6]=lane2  [5:3]=lane1  [2:0]=lane0
-- 000=nothing  001=gift  010=small  011=large  100=airbox
--
-- Addresses 0x00-0x7F: old "short" (10) -> small (010)
-- Addresses 0x80-0xFF: old "short" (10) -> large (011)
-- Old "tall/airbox" (11) -> airbox (100) throughout
--

DEPTH = 256;
WIDTH = 9;
ADDRESS_RADIX = HEX;
DATA_RADIX = BIN;

CONTENT BEGIN
    00 : 000000000;   -- l2=off    l1=off    l0=off
    01 : 000000001;   -- l2=off    l1=off    l0=gift
    02 : 010000000;   -- l2=small  l1=off    l0=off
    03 : 001000001;   -- l2=gift   l1=off    l0=gift
    04 : 000000010;   -- l2=off    l1=off    l0=small
    05 : 100000000;   -- l2=airbox l1=off    l0=off
    06 : 001001010;   -- l2=gift   l1=gift   l0=small
    07 : 010010100;   -- l2=small  l1=small  l0=airbox
    08 : 010010010;   -- l2=small  l1=small  l0=small
    09 : 000100010;   -- l2=off    l1=airbox l0=small
