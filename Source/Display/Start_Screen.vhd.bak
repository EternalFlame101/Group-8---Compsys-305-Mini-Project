library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;

entity Start_Screen is
   port (video_clock                  : in  std_logic;
         reset                        : in  std_logic;
         pixel_row, pixel_column      : in  std_logic_vector(9 downto 0);
         mouse_row, mouse_column      : in  std_logic_vector(9 downto 0);
         mouse_left_click             : in  std_logic;
         any_key_pressed              : in  std_logic;
         any_key_held                 : in  std_logic;
         sw0, sw1                     : in  std_logic;
         key2_pressed                 : in  std_logic;
         start_screen_active          : out std_logic;
         start_screen_fsm             : in  std_logic;
         selected_mode                : out std_logic;
         latched_mode                 : out std_logic;
         red_out, green_out, blue_out : out std_logic_vector(3 downto 0));
end entity Start_Screen;

architecture start_screen_behaviour of Start_Screen is

   component Word_Display is
      generic (STRING_LENGTH : positive                     := 16;
               SCALE         : positive                     := 1;
               TEXT_RED      : std_logic_vector(3 downto 0) := "1111";
               TEXT_GREEN    : std_logic_vector(3 downto 0) := "1111";
               TEXT_BLUE     : std_logic_vector(3 downto 0) := "1111");
      port (clock                        : in  std_logic;
            x_position, y_position       : in  std_logic_vector(9 downto 0);
            pixel_row, pixel_column      : in  std_logic_vector(9 downto 0);
            characters                   : in  std_logic_vector((STRING_LENGTH * 6 - 1) downto 0);
            red_out, green_out, blue_out : out std_logic_vector(3 downto 0));
   end component Word_Display;

   type screen_state_type is (title_screen, mode_select, game_running);
   signal screen_state           : screen_state_type := title_screen;
   signal selected_mode_internal : std_logic := '0';
   signal latched_mode_internal  : std_logic := '0';
   signal mouse_left_click_prev  : std_logic := '0';
   signal mode_click_armed       : std_logic := '0';
   signal title_advance_armed    : std_logic := '0';

   signal training_hovered      : std_logic;
   signal single_player_hovered : std_logic;

   -- Title screen colours
   signal title_red,       title_green,       title_blue       : std_logic_vector(3 downto 0);
   signal credits_one_red, credits_one_green, credits_one_blue : std_logic_vector(3 downto 0);
   signal credits_two_red, credits_two_green, credits_two_blue : std_logic_vector(3 downto 0);
   signal subtitle_red,    subtitle_green,    subtitle_blue    : std_logic_vector(3 downto 0);

   -- Mode select colours
   signal header_red,   header_green,   header_blue   : std_logic_vector(3 downto 0);
   signal training_small_red,      training_small_green,      training_small_blue      : std_logic_vector(3 downto 0);
   signal training_large_red,      training_large_green,      training_large_blue      : std_logic_vector(3 downto 0);
   signal single_player_small_red, single_player_small_green, single_player_small_blue : std_logic_vector(3 downto 0);
   signal single_player_large_red, single_player_large_green, single_player_large_blue : std_logic_vector(3 downto 0);
   signal training_red,      training_green,      training_blue      : std_logic_vector(3 downto 0);
   signal single_player_red, single_player_green, single_player_blue : std_logic_vector(3 downto 0);

   -- Training tip line colours
   signal tip_t1_red,  tip_t1_green,  tip_t1_blue  : std_logic_vector(3 downto 0);
   signal tip_t2_red,  tip_t2_green,  tip_t2_blue  : std_logic_vector(3 downto 0);
   signal tip_t3_red,  tip_t3_green,  tip_t3_blue  : std_logic_vector(3 downto 0);
   signal tip_t4_red,  tip_t4_green,  tip_t4_blue  : std_logic_vector(3 downto 0);
   signal tip_t5_red,  tip_t5_green,  tip_t5_blue  : std_logic_vector(3 downto 0);
   signal tip_t6_red,  tip_t6_green,  tip_t6_blue  : std_logic_vector(3 downto 0);
   signal tip_t7_red,  tip_t7_green,  tip_t7_blue  : std_logic_vector(3 downto 0);
   signal tip_t8_red,  tip_t8_green,  tip_t8_blue  : std_logic_vector(3 downto 0);
   signal tip_t9_red,  tip_t9_green,  tip_t9_blue  : std_logic_vector(3 downto 0);
   signal tip_t10_red, tip_t10_green, tip_t10_blue : std_logic_vector(3 downto 0);

   -- Single player tip line colours
   signal tip_s1_red,  tip_s1_green,  tip_s1_blue  : std_logic_vector(3 downto 0);
   signal tip_s2_red,  tip_s2_green,  tip_s2_blue  : std_logic_vector(3 downto 0);
   signal tip_s3_red,  tip_s3_green,  tip_s3_blue  : std_logic_vector(3 downto 0);
   signal tip_s4_red,  tip_s4_green,  tip_s4_blue  : std_logic_vector(3 downto 0);
   signal tip_s5_red,  tip_s5_green,  tip_s5_blue  : std_logic_vector(3 downto 0);
   signal tip_s6_red,  tip_s6_green,  tip_s6_blue  : std_logic_vector(3 downto 0);
   signal tip_s7_red,  tip_s7_green,  tip_s7_blue  : std_logic_vector(3 downto 0);

   -- Combined tip colours (ORed lines, gated by hover)
   signal training_tips_red,      training_tips_green,      training_tips_blue      : std_logic_vector(3 downto 0);
   signal single_player_tips_red, single_player_tips_green, single_player_tips_blue : std_logic_vector(3 downto 0);

   -- ---------------------------------------------------------------------------
   -- Layout constants
   -- ---------------------------------------------------------------------------
   constant TITLE_X        : integer := 152;
   constant TITLE_Y        : integer := 120;
   constant CREDITS_ONE_X  : integer := 228;
   constant CREDITS_ONE_Y  : integer := 170;
   constant CREDITS_TWO_X  : integer := 216;
   constant CREDITS_TWO_Y  : integer := 185;
   constant SUBTITLE_X     : integer := 104;
   constant SUBTITLE_Y     : integer := 320;
   constant HEADER_X       : integer := 144;
   constant HEADER_Y       : integer := 100;

   -- TRAINING: SCALE 1 small (64px wide), SCALE 2 hovered (128px wide), centred in left half [0,319]
   --   small x=(320-64)/2=128  large x=(320-128)/2=96
   --   Y: small=167 large=159 -- both bottom at row 174 (small 167+8-1, large 159+16-1)
   constant TRAINING_SMALL_X : integer := 128;
   constant TRAINING_SMALL_Y : integer := 167;
   constant TRAINING_LARGE_X : integer := 96;
   constant TRAINING_LARGE_Y : integer := 159;

   -- SINGLE PLAYER: SCALE 1 small (104px wide), SCALE 2 hovered (208px wide), centred in right half [320,639]
   --   small x=320+(320-104)/2=428  large x=320+(320-208)/2=376
   constant SINGLE_PLAYER_SMALL_X : integer := 428;
   constant SINGLE_PLAYER_SMALL_Y : integer := 167;
   constant SINGLE_PLAYER_LARGE_X : integer := 376;
   constant SINGLE_PLAYER_LARGE_Y : integer := 159;

   -- Tips: SCALE 1, X=168 centres the longest line (38 chars=304px) across the full 640px screen
   -- 12px line spacing for readability
   constant TIPS_X    : integer := 168;
   constant TIP_T1_Y  : integer := 200;
   constant TIP_T2_Y  : integer := 212;
   constant TIP_T3_Y  : integer := 224;
   constant TIP_T4_Y  : integer := 236;
   constant TIP_T5_Y  : integer := 248;
   constant TIP_T6_Y  : integer := 260;
   constant TIP_T7_Y  : integer := 272;
   constant TIP_T8_Y  : integer := 284;
   constant TIP_T9_Y  : integer := 296;
   constant TIP_T10_Y : integer := 308;
   constant TIP_S1_Y  : integer := 200;
   constant TIP_S2_Y  : integer := 212;
   constant TIP_S3_Y  : integer := 224;
   constant TIP_S4_Y  : integer := 236;
   constant TIP_S5_Y  : integer := 248;
   constant TIP_S6_Y  : integer := 260;
   constant TIP_S7_Y  : integer := 272;

   -- Hover Y bounds: 9px above TRAINING_LARGE_Y top, 7px below last training tip bottom
   constant HOVER_TOP    : integer := 150;
   constant HOVER_BOTTOM : integer := 323;

begin
   -- Hover: left/right screen half, Y-bounded so outside the button+tip area neither side is active.
   -- SW1='1' lets SW0 override mouse position (SW0=0->Training, SW0=1->Single Player).
   training_hovered <= '1' when ((mouse_column <  conv_std_logic_vector(320, 10))
                             and (mouse_row    >= conv_std_logic_vector(HOVER_TOP, 10))
                             and (mouse_row    <= conv_std_logic_vector(HOVER_BOTTOM, 10)))
                            or  (sw1 = '1' and sw0 = '0')
                    else '0';

   single_player_hovered <= '1' when ((mouse_column >= conv_std_logic_vector(320, 10))
                                  and (mouse_row    >= conv_std_logic_vector(HOVER_TOP, 10))
                                  and (mouse_row    <= conv_std_logic_vector(HOVER_BOTTOM, 10)))
                                 or  (sw1 = '1' and sw0 = '1')
                    else '0';

   -- State machine with rising-edge mouse-click detection and SW1/KEY2 support.
   -- title_advance_armed requires all inputs to be seen released at least once before
   -- any_key_pressed can fire the title->mode_select transition. This prevents
   -- PS/2 mouse-movement glitches (and held keys) from spuriously advancing the screen.
   State_Machine : process(video_clock, reset)
   begin
      if reset = '1' then
         screen_state           <= title_screen;
         selected_mode_internal <= '0';
         latched_mode_internal  <= '0';
         mouse_left_click_prev  <= '0';
         mode_click_armed       <= '0';
         title_advance_armed    <= '0';
      elsif rising_edge(video_clock) then
         mouse_left_click_prev <= mouse_left_click;

         case screen_state is
            when title_screen =>
               if any_key_held = '0' then
                  title_advance_armed <= '1';
               end if;
               if any_key_pressed = '1' and title_advance_armed = '1' then
                  screen_state     <= mode_select;
                  mode_click_armed <= '0';
               end if;

            when mode_select =>
               if mouse_left_click = '0' then
                  mode_click_armed <= '1';
               end if;

               if sw1 = '1' and key2_pressed = '1' then
                  selected_mode_internal <= sw0;
                  latched_mode_internal  <= sw0;
                  screen_state           <= game_running;
               elsif mode_click_armed = '1' and mouse_left_click = '1' and mouse_left_click_prev = '0' then
                  if training_hovered = '1' then
                     selected_mode_internal <= '0';
                     latched_mode_internal  <= '0';
                     screen_state           <= game_running;
                  elsif single_player_hovered = '1' then
                     selected_mode_internal <= '1';
                     latched_mode_internal  <= '1';
                     screen_state           <= game_running;
                  end if;
               end if;

            when game_running =>
               null;
         end case;
      end if;
   end process State_Machine;

   start_screen_active <= '0' when (screen_state = game_running) else '1';
   selected_mode       <= selected_mode_internal;
   latched_mode        <= latched_mode_internal;

   -- ---------------------------------------------------------------------------
   -- Title: "PUSHEEN'S PLOY" (14 chars, SCALE 3)
   -- ---------------------------------------------------------------------------
   Title : Word_Display
      generic map (STRING_LENGTH => 14, SCALE => 3,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "010000" & "010101" & "010011" & "001000" & "000101" & "000101" &
                                "001110" & "100111" & "010011" & "100000" & "010000" & "001100" &
                                "001111" & "011001",
                x_position   => conv_std_logic_vector(TITLE_X, 10),
                y_position   => conv_std_logic_vector(TITLE_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => title_red, green_out => title_green, blue_out => title_blue);

   -- Credits line 1: "GROUP 8 - JASPER'S KNEE" (23 chars, SCALE 1)
   Credits_One : Word_Display
      generic map (STRING_LENGTH => 23, SCALE => 1,
                   TEXT_RED => "0110", TEXT_GREEN => "0101", TEXT_BLUE => "1000")
      port map (clock        => video_clock,
                characters   => "000111" & "010010" & "001111" & "010101" & "010000" & "100000" &
                                "111000" & "100000" & "101101" & "100000" & "001010" & "000001" &
                                "010011" & "010000" & "000101" & "010010" & "100111" & "010011" &
                                "100000" & "001011" & "001110" & "000101" & "000101",
                x_position   => conv_std_logic_vector(CREDITS_ONE_X, 10),
                y_position   => conv_std_logic_vector(CREDITS_ONE_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => credits_one_red, green_out => credits_one_green, blue_out => credits_one_blue);

   -- Credits line 2: "FREDERICK, JASPER & JOHNNY" (26 chars, SCALE 1)
   Credits_Two : Word_Display
      generic map (STRING_LENGTH => 26, SCALE => 1,
                   TEXT_RED => "0110", TEXT_GREEN => "0101", TEXT_BLUE => "1000")
      port map (clock        => video_clock,
                characters   => "000110" & "010010" & "000101" & "000100" & "000101" & "010010" &
                                "001001" & "000011" & "001011" & "101100" & "100000" & "001010" &
                                "000001" & "010011" & "010000" & "000101" & "010010" & "100000" &
                                "100110" & "100000" & "001010" & "001111" & "001000" & "001110" &
                                "001110" & "011001",
                x_position   => conv_std_logic_vector(CREDITS_TWO_X, 10),
                y_position   => conv_std_logic_vector(CREDITS_TWO_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => credits_two_red, green_out => credits_two_green, blue_out => credits_two_blue);

   -- Subtitle: "CLICK ANYWHERE ON THE SCREEN/PRESS ANY KEY TO CONTINUE" (54 chars, SCALE 1)
   Subtitle : Word_Display
      generic map (STRING_LENGTH => 54, SCALE => 1,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "000011" & "001100" & "001001" & "000011" & "001011" & "100000" &
                                "000001" & "001110" & "011001" & "010111" & "001000" & "000101" &
                                "010010" & "000101" & "100000" & "001111" & "001110" & "100000" &
                                "010100" & "001000" & "000101" & "100000" & "010011" & "000011" &
                                "010010" & "000101" & "000101" & "001110" & "101111" & "010000" &
                                "010010" & "000101" & "010011" & "010011" & "100000" & "000001" &
                                "001110" & "011001" & "100000" & "001011" & "000101" & "011001" &
                                "100000" & "010100" & "001111" & "100000" & "000011" & "001111" &
                                "001110" & "010100" & "001001" & "001110" & "010101" & "000101",
                x_position   => conv_std_logic_vector(SUBTITLE_X, 10),
                y_position   => conv_std_logic_vector(SUBTITLE_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => subtitle_red, green_out => subtitle_green, blue_out => subtitle_blue);

   -- Header: "SELECT YOUR GAME MODE:" (22 chars, SCALE 2)
   Header : Word_Display
      generic map (STRING_LENGTH => 22, SCALE => 2,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "010011" & "000101" & "001100" & "000101" & "000011" & "010100" &
                                "100000" & "011001" & "001111" & "010101" & "010010" & "100000" &
                                "000111" & "000001" & "001101" & "000101" & "100000" & "001101" &
                                "001111" & "000100" & "000101" & "011101",
                x_position   => conv_std_logic_vector(HEADER_X, 10),
                y_position   => conv_std_logic_vector(HEADER_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => header_red, green_out => header_green, blue_out => header_blue);

   -- TRAINING button small (SCALE 1, resting)
   Training_Small : Word_Display
      generic map (STRING_LENGTH => 8, SCALE => 1,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "010100" & "010010" & "000001" & "001001" & "001110" & "001001" &
                                "001110" & "000111",
                x_position   => conv_std_logic_vector(TRAINING_SMALL_X, 10),
                y_position   => conv_std_logic_vector(TRAINING_SMALL_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => training_small_red, green_out => training_small_green, blue_out => training_small_blue);

   -- TRAINING button large (SCALE 2, hovered)
   Training_Large : Word_Display
      generic map (STRING_LENGTH => 8, SCALE => 2,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "010100" & "010010" & "000001" & "001001" & "001110" & "001001" &
                                "001110" & "000111",
                x_position   => conv_std_logic_vector(TRAINING_LARGE_X, 10),
                y_position   => conv_std_logic_vector(TRAINING_LARGE_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => training_large_red, green_out => training_large_green, blue_out => training_large_blue);

   -- SINGLE PLAYER button small (SCALE 1, resting)
   Single_Player_Small : Word_Display
      generic map (STRING_LENGTH => 13, SCALE => 1,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "010011" & "001001" & "001110" & "000111" & "001100" & "000101" &
                                "100000" & "010000" & "001100" & "000001" & "011001" & "000101" &
                                "010010",
                x_position   => conv_std_logic_vector(SINGLE_PLAYER_SMALL_X, 10),
                y_position   => conv_std_logic_vector(SINGLE_PLAYER_SMALL_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => single_player_small_red, green_out => single_player_small_green, blue_out => single_player_small_blue);

   -- SINGLE PLAYER button large (SCALE 2, hovered)
   Single_Player_Large : Word_Display
      generic map (STRING_LENGTH => 13, SCALE => 2,
                   TEXT_RED => "1001", TEXT_GREEN => "0111", TEXT_BLUE => "1100")
      port map (clock        => video_clock,
                characters   => "010011" & "001001" & "001110" & "000111" & "001100" & "000101" &
                                "100000" & "010000" & "001100" & "000001" & "011001" & "000101" &
                                "010010",
                x_position   => conv_std_logic_vector(SINGLE_PLAYER_LARGE_X, 10),
                y_position   => conv_std_logic_vector(SINGLE_PLAYER_LARGE_Y, 10),
                pixel_row    => pixel_row, pixel_column => pixel_column,
                red_out => single_player_large_red, green_out => single_player_large_green, blue_out => single_player_large_blue);

   -- Hover mux: show large version when hovered, small otherwise
   training_red   <= training_large_red   when training_hovered = '1' else training_small_red;
   training_green <= training_large_green when training_hovered = '1' else training_small_green;
   training_blue  <= training_large_blue  when training_hovered = '1' else training_small_blue;

   single_player_red   <= single_player_large_red   when single_player_hovered = '1' else single_player_small_red;
   single_player_green <= single_player_large_green when single_player_hovered = '1' else single_player_small_green;
   single_player_blue  <= single_player_large_blue  when single_player_hovered = '1' else single_player_small_blue;

   -- ---------------------------------------------------------------------------
   -- Training tips (SCALE 1, white text)
   -- ---------------------------------------------------------------------------
   -- "- DUCK UNDER RED OBSTACLES" (26)
   Tip_T1 : Word_Display
      generic map (STRING_LENGTH => 26, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000100" & "010101" & "000011" & "001011" &
                              "100000" & "010101" & "001110" & "000100" & "000101" & "010010" &
                              "100000" & "010010" & "000101" & "000100" & "100000" & "001111" &
                              "000010" & "010011" & "010100" & "000001" & "000011" & "001100" &
                              "000101" & "010011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T1_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t1_red, green_out => tip_t1_green, blue_out => tip_t1_blue);

   -- "- AVOID BLUE OBSTACLES" (22)
   Tip_T2 : Word_Display
      generic map (STRING_LENGTH => 22, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000001" & "010110" & "001111" & "001001" &
                              "000100" & "100000" & "000010" & "001100" & "010101" & "000101" &
                              "100000" & "001111" & "000010" & "010011" & "010100" & "000001" &
                              "000011" & "001100" & "000101" & "010011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T2_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t2_red, green_out => tip_t2_green, blue_out => tip_t2_blue);

   -- "- JUMP OVER GREEN OBSTACLES" (27)
   Tip_T3 : Word_Display
      generic map (STRING_LENGTH => 27, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "001010" & "010101" & "001101" & "010000" &
                              "100000" & "001111" & "010110" & "000101" & "010010" & "100000" &
                              "000111" & "010010" & "000101" & "000101" & "001110" & "100000" &
                              "001111" & "000010" & "010011" & "010100" & "000001" & "000011" &
                              "001100" & "000101" & "010011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T3_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t3_red, green_out => tip_t3_green, blue_out => tip_t3_blue);

   -- "- COLLECT YELLOW GIFTS, 1 POINT EACH" (36)
   Tip_T4 : Word_Display
      generic map (STRING_LENGTH => 36, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000011" & "001111" & "001100" & "001100" &
                              "000101" & "000011" & "010100" & "100000" & "011001" & "000101" &
                              "001100" & "001100" & "001111" & "010111" & "100000" & "000111" &
                              "001001" & "000110" & "010100" & "010011" & "101100" & "100000" &
                              "110001" & "100000" & "010000" & "001111" & "001001" & "001110" &
                              "010100" & "100000" & "000101" & "000001" & "000011" & "001000",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T4_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t4_red, green_out => tip_t4_green, blue_out => tip_t4_blue);

   -- "- EACH WAVE SURVIVED GIVES 1 POINT" (34)
   Tip_T5 : Word_Display
      generic map (STRING_LENGTH => 34, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000101" & "000001" & "000011" & "001000" &
                              "100000" & "010111" & "000001" & "010110" & "000101" & "100000" &
                              "010011" & "010101" & "010010" & "010110" & "001001" & "010110" &
                              "000101" & "000100" & "100000" & "000111" & "001001" & "010110" &
                              "000101" & "010011" & "100000" & "110001" & "100000" & "010000" &
                              "001111" & "001001" & "001110" & "010100",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T5_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t5_red, green_out => tip_t5_green, blue_out => tip_t5_blue);

   -- "- KEY1 / LEFT ARROW: MOVE LEFT" (30)
   Tip_T6 : Word_Display
      generic map (STRING_LENGTH => 30, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "001011" & "000101" & "011001" & "110001" &
                              "100000" & "101111" & "100000" & "001100" & "000101" & "000110" &
                              "010100" & "100000" & "000001" & "010010" & "010010" & "001111" &
                              "010111" & "011101" & "100000" & "001101" & "001111" & "010110" &
                              "000101" & "100000" & "001100" & "000101" & "000110" & "010100",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T6_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t6_red, green_out => tip_t6_green, blue_out => tip_t6_blue);

   -- "- KEY0 / RIGHT ARROW: MOVE RIGHT" (32)
   Tip_T7 : Word_Display
      generic map (STRING_LENGTH => 32, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "001011" & "000101" & "011001" & "110000" &
                              "100000" & "101111" & "100000" & "010010" & "001001" & "000111" &
                              "001000" & "010100" & "100000" & "000001" & "010010" & "010010" &
                              "001111" & "010111" & "011101" & "100000" & "001101" & "001111" &
                              "010110" & "000101" & "100000" & "010010" & "001001" & "000111" &
                              "001000" & "010100",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T7_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t7_red, green_out => tip_t7_green, blue_out => tip_t7_blue);

   -- "- LEFT CLICK / SPACE / UP ARROW: JUMP" (37)
   Tip_T8 : Word_Display
      generic map (STRING_LENGTH => 37, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "001100" & "000101" & "000110" & "010100" &
                              "100000" & "000011" & "001100" & "001001" & "000011" & "001011" &
                              "100000" & "101111" & "100000" & "010011" & "010000" & "000001" &
                              "000011" & "000101" & "100000" & "101111" & "100000" & "010101" &
                              "010000" & "100000" & "000001" & "010010" & "010010" & "001111" &
                              "010111" & "011101" & "100000" & "001010" & "010101" & "001101" &
                              "010000",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T8_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t8_red, green_out => tip_t8_green, blue_out => tip_t8_blue);

   -- "- RIGHT CLICK / DOWN ARROW: DUCK" (32)
   Tip_T9 : Word_Display
      generic map (STRING_LENGTH => 32, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "010010" & "001001" & "000111" & "001000" &
                              "010100" & "100000" & "000011" & "001100" & "001001" & "000011" &
                              "001011" & "100000" & "101111" & "100000" & "000100" & "001111" &
                              "010111" & "001110" & "100000" & "000001" & "010010" & "010010" &
                              "001111" & "010111" & "011101" & "100000" & "000100" & "010101" &
                              "000011" & "001011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T9_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t9_red, green_out => tip_t9_green, blue_out => tip_t9_blue);

   -- "- GET 10 POINTS TO WIN, GOOD LUCK" (33)
   Tip_T10 : Word_Display
      generic map (STRING_LENGTH => 33, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000111" & "000101" & "010100" & "100000" &
                              "110001" & "110000" & "100000" & "010000" & "001111" & "001001" &
                              "001110" & "010100" & "010011" & "100000" & "010100" & "001111" &
                              "100000" & "010111" & "001001" & "001110" & "101100" & "100000" &
                              "000111" & "001111" & "001111" & "000100" & "100000" & "001100" &
                              "010101" & "000011" & "001011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_T10_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_t10_red, green_out => tip_t10_green, blue_out => tip_t10_blue);

   -- ---------------------------------------------------------------------------
   -- Single Player tips (SCALE 1, white text)
   -- ---------------------------------------------------------------------------
   -- "- ANIMATION CANCELS ARE POSSIBLE" (32)
   Tip_S1 : Word_Display
      generic map (STRING_LENGTH => 32, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000001" & "001110" & "001001" & "001101" &
                              "000001" & "010100" & "001001" & "001111" & "001110" & "100000" &
                              "000011" & "000001" & "001110" & "000011" & "000101" & "001100" &
                              "010011" & "100000" & "000001" & "010010" & "000101" & "100000" &
                              "010000" & "001111" & "010011" & "010011" & "001001" & "000010" &
                              "001100" & "000101",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S1_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s1_red, green_out => tip_s1_green, blue_out => tip_s1_blue);

   -- "- CANCEL ROLL WITH OPPOSITE DIRECTION" (37)
   Tip_S2 : Word_Display
      generic map (STRING_LENGTH => 37, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000011" & "000001" & "001110" & "000011" &
                              "000101" & "001100" & "100000" & "010010" & "001111" & "001100" &
                              "001100" & "100000" & "010111" & "001001" & "010100" & "001000" &
                              "100000" & "001111" & "010000" & "010000" & "001111" & "010011" &
                              "001001" & "010100" & "000101" & "100000" & "000100" & "001001" &
                              "010010" & "000101" & "000011" & "010100" & "001001" & "001111" &
                              "001110",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S2_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s2_red, green_out => tip_s2_green, blue_out => tip_s2_blue);

   -- "- HOLD RIGHT CLICK OR DOWN ARROW: DUCK" (38)
   Tip_S3 : Word_Display
      generic map (STRING_LENGTH => 38, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "001000" & "001111" & "001100" & "000100" &
                              "100000" & "010010" & "001001" & "000111" & "001000" & "010100" &
                              "100000" & "000011" & "001100" & "001001" & "000011" & "001011" &
                              "100000" & "001111" & "010010" & "100000" & "000100" & "001111" &
                              "010111" & "001110" & "100000" & "000001" & "010010" & "010010" &
                              "001111" & "010111" & "011101" & "100000" & "000100" & "010101" &
                              "000011" & "001011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S3_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s3_red, green_out => tip_s3_green, blue_out => tip_s3_blue);

   -- "- CANCEL A JUMP WITH A DUCK" (27)
   Tip_S4 : Word_Display
      generic map (STRING_LENGTH => 27, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000011" & "000001" & "001110" & "000011" &
                              "000101" & "001100" & "100000" & "000001" & "100000" & "001010" &
                              "010101" & "001101" & "010000" & "100000" & "010111" & "001001" &
                              "010100" & "001000" & "100000" & "000001" & "100000" & "000100" &
                              "010101" & "000011" & "001011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S4_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s4_red, green_out => tip_s4_green, blue_out => tip_s4_blue);

   -- "- BARREL ROLL MID-AIR: JUMP & ROLL" (34)
   Tip_S5 : Word_Display
      generic map (STRING_LENGTH => 34, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000010" & "000001" & "010010" & "010010" &
                              "000101" & "001100" & "100000" & "010010" & "001111" & "001100" &
                              "001100" & "100000" & "001101" & "001001" & "000100" & "101101" &
                              "000001" & "001001" & "010010" & "011101" & "100000" & "001010" &
                              "010101" & "001101" & "010000" & "100000" & "100110" & "100000" &
                              "010010" & "001111" & "001100" & "001100",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S5_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s5_red, green_out => tip_s5_green, blue_out => tip_s5_blue);

   -- "- CANCEL A DUCK WITH A ROLL" (27)
   Tip_S6 : Word_Display
      generic map (STRING_LENGTH => 27, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000011" & "000001" & "001110" & "000011" &
                              "000101" & "001100" & "100000" & "000001" & "100000" & "000100" &
                              "010101" & "000011" & "001011" & "100000" & "010111" & "001001" &
                              "010100" & "001000" & "100000" & "000001" & "100000" & "010010" &
                              "001111" & "001100" & "001100",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S6_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s6_red, green_out => tip_s6_green, blue_out => tip_s6_blue);

   -- "- GET 30 POINTS TO WIN, GOOD LUCK" (33)
   Tip_S7 : Word_Display
      generic map (STRING_LENGTH => 33, SCALE => 1)
      port map (clock => video_clock,
                characters => "101101" & "100000" & "000111" & "000101" & "010100" & "100000" &
                              "110011" & "110000" & "100000" & "010000" & "001111" & "001001" &
                              "001110" & "010100" & "010011" & "100000" & "010100" & "001111" &
                              "100000" & "010111" & "001001" & "001110" & "101100" & "100000" &
                              "000111" & "001111" & "001111" & "000100" & "100000" & "001100" &
                              "010101" & "000011" & "001011",
                x_position => conv_std_logic_vector(TIPS_X, 10), y_position => conv_std_logic_vector(TIP_S7_Y, 10),
                pixel_row => pixel_row, pixel_column => pixel_column,
                red_out => tip_s7_red, green_out => tip_s7_green, blue_out => tip_s7_blue);

   -- Combined tip colours gated by hover (training has priority over single player)
   training_tips_red <=
      (tip_t1_red or tip_t2_red or tip_t3_red or tip_t4_red or tip_t5_red or
       tip_t6_red or tip_t7_red or tip_t8_red or tip_t9_red or tip_t10_red)
      when training_hovered = '1' else "0000";
   training_tips_green <=
      (tip_t1_green or tip_t2_green or tip_t3_green or tip_t4_green or tip_t5_green or
       tip_t6_green or tip_t7_green or tip_t8_green or tip_t9_green or tip_t10_green)
      when training_hovered = '1' else "0000";
   training_tips_blue <=
      (tip_t1_blue or tip_t2_blue or tip_t3_blue or tip_t4_blue or tip_t5_blue or
       tip_t6_blue or tip_t7_blue or tip_t8_blue or tip_t9_blue or tip_t10_blue)
      when training_hovered = '1' else "0000";

   single_player_tips_red <=
      (tip_s1_red or tip_s2_red or tip_s3_red or tip_s4_red or
       tip_s5_red or tip_s6_red or tip_s7_red)
      when (single_player_hovered = '1' and training_hovered = '0') else "0000";
   single_player_tips_green <=
      (tip_s1_green or tip_s2_green or tip_s3_green or tip_s4_green or
       tip_s5_green or tip_s6_green or tip_s7_green)
      when (single_player_hovered = '1' and training_hovered = '0') else "0000";
   single_player_tips_blue <=
      (tip_s1_blue or tip_s2_blue or tip_s3_blue or tip_s4_blue or
       tip_s5_blue or tip_s6_blue or tip_s7_blue)
      when (single_player_hovered = '1' and training_hovered = '0') else "0000";

   -- ---------------------------------------------------------------------------
   -- Output compositor
   -- ---------------------------------------------------------------------------
   Output_Compositor : process(screen_state,
                               title_red,         title_green,         title_blue,
                               credits_one_red,   credits_one_green,   credits_one_blue,
                               credits_two_red,   credits_two_green,   credits_two_blue,
                               subtitle_red,      subtitle_green,      subtitle_blue,
                               header_red,        header_green,        header_blue,
                               training_red,      training_green,      training_blue,
                               single_player_red, single_player_green, single_player_blue,
                               training_tips_red,      training_tips_green,      training_tips_blue,
                               single_player_tips_red, single_player_tips_green, single_player_tips_blue)
   begin
      case screen_state is
         when title_screen =>
            red_out   <= title_red   or credits_one_red   or credits_two_red   or subtitle_red;
            green_out <= title_green or credits_one_green or credits_two_green or subtitle_green;
            blue_out  <= title_blue  or credits_one_blue  or credits_two_blue  or subtitle_blue;

         when mode_select =>
            red_out   <= header_red   or training_red   or single_player_red
                      or training_tips_red   or single_player_tips_red;
            green_out <= header_green or training_green or single_player_green
                      or training_tips_green or single_player_tips_green;
            blue_out  <= header_blue  or training_blue  or single_player_blue
                      or training_tips_blue  or single_player_tips_blue;

         when game_running =>
            red_out   <= (others => '0');
            green_out <= (others => '0');
            blue_out  <= (others => '0');
      end case;
   end process Output_Compositor;

end architecture start_screen_behaviour;
